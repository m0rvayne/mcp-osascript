{
  "name": "mcp-osascript",
  "version": "1.1.3",
  "mcpName": "io.github.m0rvayne/mcp-osascript",
  "description": "MCP server for macOS automation — control apps, windows, menus, clipboard, keyboard from Claude and other AI assistants via AppleScript and JXA",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": ["darwin"],
  "scripts": {
    "start": "node server/index.js",
    "test": "node server/test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "macos",
    "macos-automation",
    "applescript",
    "osascript",
    "jxa",
    "claude",
    "claude-desktop",
    "anthropic",
    "automation",
    "ai",
    "llm",
    "desktop-extension",
    "apple",
    "system-automation"
  ],
  "bin": {
    "mcp-osascript": "server/index.js"
  },
  "files": [
    "server/index.js",
    "server/executor.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/m0rvayne/mcp-osascript.git"
  },
  "homepage": "https://github.com/m0rvayne/mcp-osascript",
  "license": "MIT"
}
